<div class="table">
  {{#if (and title (not without-title))}}
    <span class="table__title title-md font-bold">{{title}}</span>
  {{/if}}

  <div class="table__items">
    {{#each items}}
      <div class="table__item">
        <span class="text-xl">{{key}}</span>
        <span class="title-md font-bold text-no-wrap">{{value}}</span>
      </div>
    {{/each}}
  </div>
</div>