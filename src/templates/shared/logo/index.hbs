{{#if (or (not variant) (compare variant "===" "header"))}}
  <a class="logo-header link-reset {{logo-class}}" href="{{url}}">
    {{> svg id="logo"}}
  </a>
{{else}}
  {{#if (compare variant "===" "footer")}}
    <a class="logo-footer link-reset {{logo-class}}" href="{{url}}">
      {{> svg id="logo-2"}}
    </a>
  {{/if}}
{{/if}}