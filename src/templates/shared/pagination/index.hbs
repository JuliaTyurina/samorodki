<div class="pagination text-md">
  <a href="#" class="pagination__page pagination__prev" aria-label="Предыдущая страница">
    {{> svg id="chevron-left" svg-class="icon-sm" }}
  </a>

  <a href="#" class="pagination__page">1</a>
  <span class="pagination__page empty">...</span>
  <a class="pagination__page link-reset" href="#">31</a>
  <span class="pagination__page pagination__page--current link-reset">32</span>
  <a class="pagination__page link-reset" href="#">33</a>
  <span class="pagination__page empty">...</span>
  <a class="pagination__page link-reset" href="#">48</a>

  <a href="#" class="pagination__page pagination__next link-reset" aria-label="Следующая страница">
    {{> svg id="chevron-right" svg-class="icon-sm" }}
  </a>
</div>