/*
	Для ошибки добавить класс error
	Для успеха добавить класс success
 */

.input {
	width : 100%;

	&--sm {
		.input__main {
			padding : 9px 11px;
		}
	}

	&--md {
		.input__main {
			padding : 13px 15px;
		}
	}

	&--lg {
		.input__main {
			padding : 15px;
		}
	}

	&__label {
		display        : flex;
		flex-direction : column;
		gap            : 4px;

		&-text {
			user-select : none;
		}
	}

	&.error {
		.input {
			&__main {
				border-color     : var(--color-error);
				background-color : var(--color-background-error);
			}

			&__hint {
				color : var(--color-error);
			}
		}
	}

	&.success {
		.input {
			&__main {
				border-color     : var(--color-success);
				background-color : var(--color-background-success);
			}

			&__hint {
				color : var(--color-success);
			}
		}
	}

	.input__main {
		display          : block;
		width            : 100%;
		font-size        : 14px;
		font-weight      : 400;
		line-height      : 1.4;
		color            : var(--color-text-primary);
		background-color : var(--color-background-primary);
		border           : 1px solid var(--color-stroke-primary);
		border-radius    : 8px;
		transition       : color var(--transition-default), background-color var(--transition-default), border var(--transition-default);

		&:hover,
		&:focus-visible {
			outline : none;
		}

		&:hover {
			border-color : var(--color-stroke-contrast);
		}

		&:focus-visible {
			border-color : var(--color-stroke-accent);
		}

		&::placeholder {
			color : var(--color-text-secondary);
		}
	}

	&__hint {
		font-size   : 12px;
		font-weight : 500;
		color       : var(--color-text-tertiary);
		line-height : 1.3;
		display     : block;
		margin-top  : 4px;
	}

	textarea {
		resize : vertical;
	}
}

