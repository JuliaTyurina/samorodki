<label class="radio">
  <span class="radio__icon">
    <input id="{{id}}" type="radio" name="{{name}}" {{set-checked checked}} {{set-disabled disabled}} aria-label="{{text}}">
    {{> svg id="radio" svg-class="default icon-lg"}}
    {{> svg id="radio-checked" svg-class="checked icon-lg"}}
  </span>
  <span class="radio__text">
    <span class="radio__title">{{text}}</span>
    {{#if description }}
      <span class="radio__descr">{{description}}</span>
    {{/if}}
  </span>
    {{#if price }}
    <span class="radio__price"> от {{ price }}₽ </span>
    {{/if}}

</label>