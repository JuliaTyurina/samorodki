<div class="quantity {{#if accent}}quantity-accent{{/if}} {{quantity-class}}" >
    <button class="quantity-minus"
            aria-label="Уменьшить количество">{{> svg id="minus" }}</button>
    <label class="quantity-label">
        <span class="visually-hidden">Количество товара</span>
        <input id="quantity-input" class="quantity-input" type="number" value="1" min="1" max="10" step="1" aria-labelledby="quantity-label">
    </label>
    <button class="quantity-plus"
            aria-label="Увеличить количество">{{> svg id="plus" }}</button>
</div>