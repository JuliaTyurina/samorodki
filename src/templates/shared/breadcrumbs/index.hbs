<!-- breadcrumbs-->
<div class="breadcrumbs">
    <div class="breadcrumbs__container __container">
        <div class="breadcrumbs__items">
            {{#each list}}
                {{#if url}}
                    <a class="breadcrumbs__link text-gray" href="{{url}}">{{> svg id="arrow-left" }}{{text}}</a>
                {{else}}
                    <span class="breadcrumbs__current">{{text}}</span>
                {{/if}}
            {{/each}}
        </div>
        {{#if share}}
            {{> share }}
        {{/if}}
    </div>
</div>


