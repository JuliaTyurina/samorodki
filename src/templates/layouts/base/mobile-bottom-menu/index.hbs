<div class="mobile-bottom-menu">
  <div class="mobile-bottom-menu__background" data-global-action="mobile-bottom-menu-close"></div>
  <div class="mobile-bottom-menu__wrapper">
    <div class="mobile-bottom-menu__header"></div>
    <div class="mobile-bottom-menu__content">
        <div class="mobile-bottom-menu__sort-catalog">
            {{> sort-catalog }}
        </div>

        <div class="mobile-bottom-menu__sort-feedback">
            {{> sort-feedback}}
        </div>

        <div class="mobile-bottom-menu__product">
            {{> menu-product }}
        </div>

        <div class="mobile-bottom-menu__product-added">
            {{> menu-product-added }}
        </div>

        <div class="mobile-bottom-menu__support">
            {{> menu-support }}
        </div>

        <div class="mobile-bottom-menu__locality">
            {{> menu-locality }}
        </div>

        <div class="mobile-bottom-menu__delivery-point">
            {{> menu-delivery-point }}
        </div>

    </div>
    <div class="mobile-bottom-menu__footer"></div>
  </div>
</div>