<div class="sort-feedback">
    <span class="sort-feedback__title title-sm font-bold text-center">Сортировка</span>
    <ul class="sort-feedback__list list-reset">
        <li>
            <label>
                <input type="radio" name="sort" checked>
                <span class="text-md font-medium">
          <span>
            <span>Сначала полезные</span>
          </span>
                    {{> svg id="check" svg-class="icon-xmd" }}
        </span>
            </label>
        </li>
        <li>
            <label>
                <input type="radio" name="sort">
                <span class="text-md font-medium">
          <span>
            <span>С высокой оценкой</span>
          </span>
                    {{> svg id="check" svg-class="icon-xmd" }}
        </span>
            </label>
        </li>

        <li>
            <label>
                <input type="radio" name="sort">
                <span class="text-md font-medium">
          <span>
            <span>С низкой оценкой</span>
          </span>
                    {{> svg id="check" svg-class="icon-xmd" }}
        </span>
            </label>
        </li>
        <li>
            <label>
                <input type="radio" name="sort">
                <span class="text-md font-medium">
          <span>
            <span>Сначала новые</span>
          </span>
                    {{> svg id="check" svg-class="icon-xmd" }}
        </span>
            </label>
        </li>
        <li>
            <label>
                <input type="radio" name="sort">
                <span class="text-md font-medium">
          <span>
            <span>Сначала старые</span>
          </span>
                    {{> svg id="check" svg-class="icon-xmd" }}
        </span>
            </label>
        </li>
    </ul>
</div>