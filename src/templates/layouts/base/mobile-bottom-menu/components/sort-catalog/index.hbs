        <input type="radio" name="sort" checked>
        <span class="text-md font-medium">
          <span>
            <span>По популярности</span>
          </span>
          {{> svg id="check" svg-class="icon-xmd" }}
        </span>
      </label>
    </li>
    <li>
      <label>
