<div class="drawer" tabindex="-1">
  <div class="drawer__overlay" data-global-action="drawer-close"></div>
  <div class="drawer__wrapper">
      <button class="drawer__close" data-global-action="drawer-close">
          {{> svg id="cancel" svg-class="drawer__close-icon" }}
      </button>

      <div class="drawer__content">
          <div class="drawer__product">
              {{> menu-product }}
          </div>

          <div class="drawer__product-added">
              {{> menu-product-added }}
          </div>

          <div class="drawer__product-counter">
              {{> menu-product-counter }}
          </div>

          <div class="drawer__support">
              {{> menu-support }}
          </div>

          <div class="drawer__locality">
              {{> menu-locality }}
          </div>

          <div class="drawer__delivery-point">
              {{> menu-delivery-point }}
          </div>

          <div class="drawer__feedback">
              {{> menu-feedback }}
          </div>

          <div class="drawer__feedback-not-auth">
              {{> menu-feedback-not-auth }}
          </div>

          <div class="drawer__login-number">
              {{> menu-login-number }}
          </div>

          <div class="drawer__login-number-confirmation-step-1">
              {{> menu-login-number-confirmation-step-1 }}
          </div>

          <div class="drawer__login-number-confirmation-step-2">
              {{> menu-login-number-confirmation-step-2 }}
          </div>

          <div class="drawer__login-captcha">
              {{> menu-login-captcha }}
          </div>
      </div>
  </div>
</div>