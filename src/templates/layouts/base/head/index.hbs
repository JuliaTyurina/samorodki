<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{{ pageTitle }}</title>
    <style>
        #preloader {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #fff;
            z-index: 100;
        }

        #preloader svg {
            width: 32px;
            height: 32px;
            animation: spin 1.5s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        #preloader.hidden {
            display: none;
        }


    </style>
</head>