<div class="filters">
  {{> filters-group-type filters-group-class="open" }}
  {{> filters-group-price filters-group-class="open" }}
  {{> filters-group-material filters-group-class="open" }}
  {{> filters-group-color filters-group-class="open" }}
  {{> filters-group-insert }}
  {{> filters-group-for }}
  {{> filters-group-coating filters-group-class="open" }}

  <div class="filters__switchers">
    {{> switcher text="Только скидки" checked=true }}
    {{> switcher text="Новинки" }}
    {{> switcher text="Хиты"}}
  </div>
</div>