<div class="filters-group {{filters-group-class}}">
  <div class="filters-group__header">
    <button class="filters-group__title">
      <span class="text-xl font-bold">Цвет</span>
      {{> svg id="chevron-up"}}
    </button>
  </div>
  <div class="filters-group__main">
    <div class="filters-group__list">
      {{> checkbox text="Бежевый" color="#EDE6CA" }}
      {{> checkbox text="Белый" color="#FFF" round-class="border" }}
      {{> checkbox text="Голубой" color="#3AA4E8" }}
      {{> checkbox text="Желтый" color="#FFD014" }}
      {{> checkbox text="Зеленый" color="#1FAD36" }}
      {{> checkbox text="Красный" color="#EC3713" }}
      {{> checkbox text="Розовый" color="#FFE4E3" }}
    </div>
  </div>
</div>