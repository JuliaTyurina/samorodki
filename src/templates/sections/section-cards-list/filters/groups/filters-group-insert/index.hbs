    <button class="filters-group__title">
      <span class="text-xl font-bold">Вставка</span>
      {{> svg id="chevron-up"}}
    </button>
  </div>
  <div class="filters-group__main">
    <div class="filters-group__list">
      {{> checkbox text="Родий" }}
      {{> checkbox text="Золото" }}
    </div>
  </div>
</div>