<section class="contacts {{section-class}}">
    <div class="contacts__container __container">
        <h1 class="title-lg font-semibold">
            Контакты
        </h1>
        <div class="contacts__wrapper">
            <div class="contacts__section" id="map">
                <div class="contacts__map">
                    <iframe src="https://yandex.ru/map-widget/v1/?um=constructor%3Ad20af0a3d347c55f1d10214e07ba2bed7bfbb88881f8428613362d170b8a9721&amp;source=constructor"
                            width="100%" height="240" frameborder="0"></iframe>
                </div>
                <address class="contacts__content">
                    <div class="contacts__address">
                        <span class="title-sm font-bold">Москва, Искры, 17а, стр.3</span>
                    </div>

                    <div class="contacts__element">
                        <p class="text-lg text-gray font-medium">контактный телефон</p>
                        <div class="contacts__phones">
                            <a href="#" class="text-lg font-bold">8 926 193 33 58</a>
                        </div>
                        <p class="text-lg font-medium">ежедневно, 9:00 — 22:00</p>
                    </div>

                    <div class="contacts__element">
                        <p class="text-lg text-gray font-medium">почта</p>
                        <div class="contacts__emails">
                            <a href="#" class="text-lg font-bold">samorodki@yandex.ru</a>
                        </div>
                    </div>

                    <div class="contacts__element">
                        <p class="text-lg text-gray font-medium">соц. сети</p>
                        <div class="contacts__socials">
                            <a href="#" class="text-lg font-semibold">
                                {{> svg id="telegram"}}
                                телеграм
                            </a>
                            <a href="#" class="text-lg font-semibold">
                                {{> svg id="whatsapp"}}
                                whatsapp
                            </a>
                            <a href="#" class="text-lg font-semibold">
                                {{> svg id="viber"}}
                                viber
                            </a>
                        </div>
                    </div>

                    <a href="#gallery" class="contacts__anchor text-lg font-semibold">
                        {{> svg id="refresh"}}
                        фотогалерея
                    </a>
                </address>
            </div>
            <div class="contacts__section" id="gallery">
                <div class="swiper">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="/assets/media/images/contact-img.png" alt="">
                        </div>
                        <div class="swiper-slide">
                            <img src="/assets/media/images/material_2.png" alt="">
                        </div>
                        <div class="swiper-slide">
                            <img src="/assets/media/images/material_1.png" alt="">
                        </div>
                    </div>
                </div>
                <address class="contacts__content">
                    <div class="contacts__address">
                        <span class="title-sm font-bold">Кострома, Сутырина, д.3</span>
                    </div>

                    <div class="contacts__element">
                        <p class="text-lg text-gray font-medium">контактный телефон</p>
                        <div class="contacts__phones">
                            <a href="#" class="text-lg font-bold">8 926 193 33 58</a>
                        </div>
                        <p class="text-lg font-medium">ежедневно, 9:00 — 22:00</p>
                    </div>

                    <div class="contacts__element">
                        <p class="text-lg text-gray font-medium">почта</p>
                        <div class="contacts__emails">
                            <a href="#" class="text-lg font-bold">samorodki@yandex.ru</a>
                        </div>
                    </div>

                    <div class="contacts__element">
                        <p class="text-lg text-gray font-medium">соц. сети</p>
                        <div class="contacts__socials">
                            <a href="#" class="text-lg font-semibold">
                                {{> svg id="telegram"}}
                                телеграм
                            </a>
                            <a href="#" class="text-lg font-semibold">
                                {{> svg id="whatsapp"}}
                                whatsapp
                            </a>
                            <a href="#" class="text-lg font-semibold">
                                {{> svg id="viber"}}
                                viber
                            </a>
                        </div>
                    </div>

                    <a href="#map" class="contacts__anchor text-lg font-semibold">
                        {{> svg id="refresh"}}
                        на карте
                    </a>
                </address>
            </div>
        </div>
    </div>
</section>


