<section class="promo-archive {{section-class}}">
    <div class="promo-archive__container __container">
        <h1 class="promo-archive__title title-lg font-bold">
            Акции
        </h1>
        <ul class="promo-archive__list list-reset">
            {{#each promo-context.promos }}
                <li class="promo-archive__item">
                    <a href="#" class="promo-archive__link">
                        <article class="promo-archive__card">
                            <div class="promo-archive__card-media">
                                <img src="{{url}}" alt="" class="promo-archive__card-img">
                            </div>
                            <div class="promo-archive__card-descr">
                                <h2 class="promo-archive__card-title title-md font-bold">{{title}}</h2>
                                <p class="promo-archive__card-text text-lg font-medium">{{description}}</p>
                            </div>
                        </article>
                    </a>
                </li>
            {{/each}}
        </ul>
    </div>
</section>


