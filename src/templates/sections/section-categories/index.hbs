<!-- section-categories -->
<section class="section-categories {{section-class}}">
  <div class="section-categories__container __container">
    <h2 class="section-categories__title title-lg font-semibold">Категории</h2>
    <div class="categories-list">
      {{#each categories-context.list }}
        <a href="#">
          <span>
            <img src="{{image}}" alt="{{title}}">
          </span>
          <span class="font-bold">{{title}}</span>
        </a>
      {{/each}}
    </div>
  </div>
</section>