<section class="section-slider-full {{section-class}}">
  <div class="__container-big">
    <div class="slider-full">
      <div class="swiper">
        <div class="swiper-wrapper">
          {{#each slider-full-context.slides}}
            <div class="swiper-slide">
              <img src="{{img}}" alt="">
              <div class="slider-full-content">
                <div>
                  <span class="heading-md font-medium">{{title}}</span>
                  <span class="text-xl">{{description}}</span>

                  {{> button variant="gray" url=url text="Перейти в каталог"}}
                </div>
              </div>
            </div>
          {{/each}}
          {{#each slider-full-context.slides}}
            <div class="swiper-slide">
              <img src="{{img}}" alt="">
              <div class="slider-full-content">
                <div>
                  <span class="heading-md font-medium">{{title}}</span>
                  <span class="text-xl">{{description}}</span>

                  {{> button variant="gray" url=url text="Перейти в каталог"}}
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      </div>
      <div class="slider-full-pagination"></div>
    </div>
  </div>
</section>