<div class="snackbar text-md font-bold" data-status="success">
    {{> svg id="status-success" svg-class="snackbar__icon" }}
    Вход успешен
    <button class="snackbar__close" aria-label="Закрыть уведомление">
        {{> svg id="cancel"}}
    </button>
</div>

<div class="snackbar text-md font-bold" data-status="error">
    {{> svg id="status-error" svg-class="snackbar__icon" }}
    Ошибка
    <button class="snackbar__close" aria-label="Закрыть уведомление">
        {{> svg id="cancel"}}
    </button>
</div>

<div class="snackbar text-md font-bold" data-status="warning">
    {{> svg id="status-warning" svg-class="snackbar__icon" }}
    Внимание
    <button class="snackbar__close" aria-label="Закрыть уведомление">
        {{> svg id="cancel"}}
    </button>
</div>

<div class="snackbar text-md font-bold" data-status>
    {{> svg id="status-initial" svg-class="snackbar__icon" }}
    Вход успешен
    <button class="snackbar__close" aria-label="Закрыть уведомление">
        {{> svg id="cancel"}}
    </button>
</div>