<div class="search {{search-class}}">
    <div class="search__input-wrapper">
        <input class="search__input" type="text" name="search" placeholder="Поиск по более чем 10 000 товарам">
        <button class="search__button search__button--normal" data-global-action="search-open"
                aria-label="Искать товар">
            {{> svg id="search" svg-class="icon-md" }}
        </button>
        <button class="search__button search__button--cancel" data-global-action="search-close"
                aria-label="Закрыть меню поиска">
            {{> svg id="cancel" svg-class="icon-md" }}
        </button>
        <div class="search__result">
            <div class="search__result-wrapper">
                {{> search-content }}
            </div>
        </div>
    </div>
    <div class="search__background" data-global-action="search-close"></div>
</div>