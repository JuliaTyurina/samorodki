<article class="card-product" {{#if (str-equals media-type "image")}} data-product-image2="/assets/media/images/seo-1-image.jpg"{{else}} data-product-video="/assets/media/videos/product_card_video.mp4"{{/if}}>
  <a class="card-product__link" href="#" aria-label="Перейти на страницу товара"></a>
  <div class="card-product__media-wrapper">
    <div class="card-product__media">
      <div class="card-product__media-layer">
        <div class="card-product__tags">
          {{#if tags}}
            {{#each tags}}
              <div class="card-product__tag text-sm font-bold card-product__tag--{{type}}">{{text}}</div>
            {{/each}}
          {{/if}}
        </div>
        {{#if favourite}}
            {{> favorite-filled favorite-class="card-product__favorite" selected=true }}
        {{else}}
            {{> favorite-filled favorite-class="card-product__favorite" }}
        {{/if}}

      </div>
      <div class="card-product__image">
        <img src="{{image}}" alt="{{title}}">
      </div>
      <div class="card-product__media-entry"></div>
    </div>
    <button class="card-product__add-to-cart desktop" data-global-action="drawer-open" data-drawer="product" aria-label="Добавить товар в корзину">
      {{> svg id="cart" }}
    </button>
      <button class="card-product__add-to-cart mobile" data-global-action="mobile-bottom-menu-open" data-bottom-menu="product" aria-label="Добавить товар в корзину">
          {{> svg id="cart" }}
      </button>
  </div>
  <div class="card-product__info">
    <div class="card-product__price-block">
      <div class="card-product__price-wrapper">
        <div class="card-product__prices">
          <span class="card-product__price title-md font-bold">{{price.normal}}</span>
          {{#if price.old}}
            <span class="card-product__price-old font-medium text-gray text-through">{{price.old}}</span>
          {{/if}}
        </div>
        {{#if price.discount}}
          <span class="card-product__price-discount text-sm font-bold">{{price.discount}}</span>
        {{/if}}
      </div>
      {{> rating value=rating rating-class="__hide-before-lg"}}
    </div>
    <span class="card-product__title" title="{{title}}">{{title}}</span>
    {{> rating value=rating rating-class="__hide-after-md"}}
  </div>
</article>